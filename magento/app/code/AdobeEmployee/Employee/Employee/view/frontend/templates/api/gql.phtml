<div id="employee-gql-container">
    <!-- ko scope: 'employeeGql' -->

    <div data-bind="visible: !isFormVisible()">
        <div style="display:flex; align-items:center; gap:20px; margin-bottom:15px;">
            <h2 style="margin:0;"><?= $escaper->escapeHtml(__('Employee Details')) ?></h2>

            <button type="button" class="action primary" data-bind="click: showAddForm">
                <?= $escaper->escapeHtml(__('Add Employee')) ?>
            </button>
        </div>

        <table class="data table">
            <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Joining Date</th>
                <th>Designation</th>
                <th>Address</th>
                <th>Status</th>
                <th>Hobbies</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody data-bind="foreach: employees">
            <tr>
                <td data-bind="text: id"></td>
                <td data-bind="text: name"></td>
                <td data-bind="text: joining_date"></td>
                <td data-bind="text: designation"></td>
                <td data-bind="text: address"></td>
                <td data-bind="text: status == 1 ? 'Active' : 'Inactive'"></td>
                <td data-bind="text: hobbies_text"></td>
                <td>
                    <a href="javascript:void(0)" data-bind="click: function () { $parent.editEmployee($data); }">Edit</a>
                    |
                    <a href="javascript:void(0)" data-bind="click: function () { $parent.deleteEmployee($data); }">Delete</a>
                </td>
            </tr>
            </tbody>
        </table>
    </div>

    <div data-bind="visible: isFormVisible" style="display:none;">
        <form data-bind="submit: saveEmployee">
            <fieldset class="fieldset">
                <legend class="legend">
                    <span data-bind="text: formTitle"></span>
                </legend>

                <div class="field required">
                    <label class="label"><span>Name</span></label>
                    <div class="control">
                        <input type="text" class="input-text" data-bind="value: name"/>
                    </div>
                </div>

                <div class="field required">
                    <label class="label"><span>Joining Date</span></label>
                    <div class="control">
                        <input type="date" class="input-text" data-bind="value: joiningDate"/>
                    </div>
                </div>

                <div class="field required">
                    <label class="label"><span>Designation</span></label>
                    <div class="control">
                        <input type="text" class="input-text" data-bind="value: designation"/>
                    </div>
                </div>

                <div class="field">
                    <label class="label"><span>Address</span></label>
                    <div class="control">
                        <textarea class="input-text" data-bind="value: address"></textarea>
                    </div>
                </div>

                <div class="field">
                    <label class="label"><span>Status</span></label>
                    <div class="control">
                        <select data-bind="value: status">
                            <option value="1">Active</option>
                            <option value="0">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="field">
                    <label class="label"><span>Hobbies</span></label>
                    <div class="control">
                        <!-- ko foreach: hobbyOptions -->
                        <label style="margin-right:15px;">
                            <input type="checkbox" data-bind="checked: $parent.hobbies, checkedValue: value"/>
                            <span data-bind="text: label"></span>
                        </label>
                        <!-- /ko -->
                    </div>
                </div>
            </fieldset>

            <div class="actions-toolbar">
                <div class="primary">
                    <button type="submit" class="action save primary">
                        <span>Save</span>
                    </button>
                </div>
                <div class="secondary">
                    <button type="button" class="action secondary" data-bind="click: cancelForm">
                        <span>Cancel</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

