<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">

            <!-- Existing normal frontend page -->
            <block class="Magento\Customer\Block\Account\SortLinkInterface"
                   name="customer-account-navigation-adobe-employee-link">
                <arguments>
                    <argument name="path" xsi:type="string">adobeemployee/employee/index</argument>
                    <argument name="label" xsi:type="string" translate="true">Adobe Employee</argument>
                    <argument name="sortOrder" xsi:type="number">235</argument>
                </arguments>
            </block>

            <!-- New KnockoutJS AJAX page -->
            <block class="Magento\Customer\Block\Account\SortLinkInterface"
                   name="customer-account-navigation-knockout-employee-link">
                <arguments>
                    <argument name="path" xsi:type="string">adobeemployee/knockout/index</argument>
                    <argument name="label" xsi:type="string" translate="true">Knockout Employee</argument>
                    <argument name="sortOrder" xsi:type="number">236</argument>
                </arguments>
            </block>

            <!-- New Rest API page -->
            <block class="Magento\Customer\Block\Account\SortLinkInterface"
                   name="customer-account-navigation-employee-rest-link">
                <arguments>
                    <argument name="path" xsi:type="string">adobeemployee/rest/index</argument>
                    <argument name="label" xsi:type="string" translate="true">Employee Rest</argument>
                    <argument name="sortOrder" xsi:type="number">237</argument>
                </arguments>
            </block>

            <!-- New GraphQL page -->
            <block class="Magento\Customer\Block\Account\SortLinkInterface"
                   name="customer-account-navigation-employee-gql-link">
                <arguments>
                    <argument name="path" xsi:type="string">adobeemployee/gql/index</argument>
                    <argument name="label" xsi:type="string" translate="true">Employee GQL</argument>
                    <argument name="sortOrder" xsi:type="number">238</argument>
                </arguments>
            </block>

        </referenceBlock>
    </body>
</page>