/** @var \Magento\Framework\View\Element\Template $block */
?>

<div id="employee-knockout-container">
    <!-- ko scope: 'employeeCrud' -->

    <!-- LISTING SECTION -->
    <div data-bind="visible: !isFormVisible()">

        <div style="display:flex; align-items:center; gap:20px; margin-bottom:15px;">
            <h2 style="margin:0;">
                <?= $escaper->escapeHtml(__('Employee Details')) ?>
            </h2>

            <button type="button"
                    class="action primary"
                    data-bind="click: showAddForm">
                <?= $escaper->escapeHtml(__('Add Employee')) ?>
            </button>
        </div>

        <table class="data table">
            <thead>
            <tr>
                <th><?= $escaper->escapeHtml(__('ID')) ?></th>
                <th><?= $escaper->escapeHtml(__('Name')) ?></th>
                <th><?= $escaper->escapeHtml(__('Joining Date')) ?></th>
                <th><?= $escaper->escapeHtml(__('Designation')) ?></th>
                <th><?= $escaper->escapeHtml(__('Address')) ?></th>
                <th><?= $escaper->escapeHtml(__('Status')) ?></th>
                <th><?= $escaper->escapeHtml(__('Hobbies')) ?></th>
                <th><?= $escaper->escapeHtml(__('Action')) ?></th>
            </tr>
            </thead>

            <tbody data-bind="foreach: employees">
            <tr>
                <td data-bind="text: id"></td>
                <td data-bind="text: name"></td>
                <td data-bind="text: joining_date"></td>
                <td data-bind="text: designation"></td>
                <td data-bind="text: address"></td>
                <td data-bind="text: status == 1 ? 'Active' : 'Inactive'"></td>
                <td data-bind="text: hobbies_text"></td>
                <td>
                    <a href="javascript:void(0)"
                       data-bind="click: function () { $parent.editEmployee($data); }">
                        <?= $escaper->escapeHtml(__('Edit')) ?>
                    </a>
                    |
                    <a href="javascript:void(0)"
                       data-bind="click: function () { $parent.deleteEmployee($data); }">
                        <?= $escaper->escapeHtml(__('Delete')) ?>
                    </a>
                </td>
            </tr>
            </tbody>
        </table>

        <!-- ko if: employees().length === 0 -->
        <p><?= $escaper->escapeHtml(__('No employee records found.')) ?></p>
        <!-- /ko -->
    </div>

    <!-- FORM SECTION -->
    <div data-bind="visible: isFormVisible" style="display:none;">
        <form data-bind="submit: saveEmployee">
            <fieldset class="fieldset">
                <legend class="legend">
                    <span data-bind="text: formTitle"></span>
                </legend>

                <div class="field required">
                    <label class="label">
                        <span><?= $escaper->escapeHtml(__('Name')) ?></span>
                    </label>
                    <div class="control">
                        <input type="text" class="input-text" data-bind="value: name"/>
                    </div>
                </div>

                <div class="field required">
                    <label class="label">
                        <span><?= $escaper->escapeHtml(__('Joining Date')) ?></span>
                    </label>
                    <div class="control">
                        <input type="date" class="input-text" data-bind="value: joiningDate"/>
                    </div>
                </div>

                <div class="field required">
                    <label class="label">
                        <span><?= $escaper->escapeHtml(__('Designation')) ?></span>
                    </label>
                    <div class="control">
                        <input type="text" class="input-text" data-bind="value: designation"/>
                    </div>
                </div>

                <div class="field">
                    <label class="label">
                        <span><?= $escaper->escapeHtml(__('Address')) ?></span>
                    </label>
                    <div class="control">
                        <textarea class="input-text" data-bind="value: address"></textarea>
                    </div>
                </div>

                <div class="field required">
                    <label class="label">
                        <span><?= $escaper->escapeHtml(__('Status')) ?></span>
                    </label>
                    <div class="control">
                        <select data-bind="value: status">
                            <option value="1"><?= $escaper->escapeHtml(__('Active')) ?></option>
                            <option value="0"><?= $escaper->escapeHtml(__('Inactive')) ?></option>
                        </select>
                    </div>
                </div>

                <div class="field">
                    <label class="label">
                        <span><?= $escaper->escapeHtml(__('Hobbies')) ?></span>
                    </label>
                    <div class="control">
                        <!-- ko foreach: hobbyOptions -->
                        <label style="margin-right:15px;">
                            <input type="checkbox"
                                   data-bind="checked: $parent.hobbies, checkedValue: value"/>
                            <span data-bind="text: label"></span>
                        </label>
                        <!-- /ko -->
                    </div>
                </div>
            </fieldset>

            <div class="actions-toolbar">
                <div class="primary">
                    <button type="submit" class="action save primary">
                        <span><?= __('Save') ?></span>
                    </button>
                </div>

                <div class="secondary">
                    <button type="button"
                            class="action secondary"
                            data-bind="click: cancelForm">
                        <span><?= __('Cancel') ?></span>
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- /ko -->
</div>

<script type="text/x-magento-init">
{
    "#employee-knockout-container": {
        "Magento_Ui/js/core/app": {
            "components": {
                "employeeCrud": {
                    "component": "Adobe_Employee/js/employee-crud",
                    "listUrl": "<?= $escaper->escapeJs($block->getUrl('adobeemployee/ajax/listJson')) ?>",
                    "getUrl": "<?= $escaper->escapeJs($block->getUrl('adobeemployee/ajax/get')) ?>",
                    "saveUrl": "<?= $escaper->escapeJs($block->getUrl('adobeemployee/ajax/save')) ?>",
                    "deleteUrl": "<?= $escaper->escapeJs($block->getUrl('adobeemployee/ajax/delete')) ?>"
                }
            }
        }
    }
}
</script>