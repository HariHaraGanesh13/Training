<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="adobe_employee" resource="default" engine="innodb" comment="Adobe Employee Table">
        <column xsi:type="int" name="id" nullable="false" identity="true" unsigned="true" comment="ID"/>
        <column xsi:type="int" name="customer_id" nullable="false" unsigned="true" default="0" comment="Customer ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="date" name="joining_date" nullable="true" comment="Joining Date"/>
        <column xsi:type="varchar" name="designation" nullable="true" length="255" comment="Designation"/>
        <column xsi:type="text" name="address" nullable="true" comment="Address"/>
        <column xsi:type="smallint" name="status" nullable="false" default="1" comment="Status"/>
        <column xsi:type="text" name="hobbies" nullable="true" comment="Hobbies"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>

        <index referenceId="ADOBE_EMPLOYEE_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>
</schema>